# SPDX-License-Identifier: GPL-2.0-only
# Merge after the granted block-device profile. The VFS and filesystem
# implementations stay upstream; do not introduce a second storage cache.
CONFIG_KOBOX_HOSTED=y
CONFIG_64BIT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PRINTK=y
CONFIG_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLOCK=y
# Storage hot allocation needs upstream per-CPU SLUB paths, not tinyconfig's
# shared-node size-saving allocator. Keep unrelated debug/stacktrace off.
# CONFIG_SLUB_TINY is not set
# CONFIG_SLUB_DEBUG is not set
# Native stack-switch, IBT and ISA instructions have no hosted machine grant.
# CONFIG_VMAP_STACK is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_ISA_DMA_API is not set
CONFIG_EXT4_FS=m
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_JBD2=m
CONFIG_FS_MBCACHE=m
CONFIG_CRC16=m
