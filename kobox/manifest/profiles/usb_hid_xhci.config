# SPDX-License-Identifier: GPL-2.0-only
# The boot-rooted Linux core owns input registration; the host supplies only
# the granted PCI function, DMA domain, and interrupt routes.
CONFIG_KOBOX_HOSTED=y
CONFIG_64BIT=y
# The hosted irq-stack port has no native VMAP overflow stack switch.
# CONFIG_VMAP_STACK is not set
# The hosted compiler path does not publish native IBT landing pads.
# CONFIG_X86_KERNEL_IBT is not set
# These native process/ISA facilities are outside the hosted machine contract.
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_ISA_DMA_API is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PRINTK=y
# USB hub port registration requires a sysfs state node even without a
# userspace sysfs mount; disabling SYSFS makes hub probe return -ENODEV.
CONFIG_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=m
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_HID_SUPPORT=y
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m
