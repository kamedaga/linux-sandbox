# Merge after the canonical base configuration and kobox/task/config.
# Use the KBUILD_KCONFIG entry generated by kobox/boot/prepare_kconfig.py.
CONFIG_KOBOX_HOSTED=y
# Client credentials must retain real UID/GID and permission semantics.
CONFIG_MULTIUSER=y
# User-thread waits and clear_child_tid wakeups use upstream futexes.
CONFIG_FUTEX=y
# Executable layout, argv/auxv and exec credentials belong to upstream.
CONFIG_BINFMT_ELF=y
# File transfer uses upstream AF_UNIX/SCM_RIGHTS, not a parallel FD table.
CONFIG_NET=y
CONFIG_UNIX=y
# CONFIG_INET is not set
# Real shmem/tmpfs, not the ramfs-backed tiny implementation.
CONFIG_MMU=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
# Retain upstream cache-type reservation and distinct WC PTE encoding.
# X86_PAT depends on MTRR; the host still owns physical MSR programming.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
# Keep IOVA allocation and scatter/gather DMA in the upstream IOMMU layer.
# Strict invalidation is required before a revoked IOVA can be reused.
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
