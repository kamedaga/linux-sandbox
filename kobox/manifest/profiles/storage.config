# SPDX-License-Identifier: GPL-2.0-only
# Merge after the granted block-device profile. The VFS and filesystem
# implementations stay upstream; do not introduce a second storage cache.
CONFIG_KOBOX_HOSTED=y
CONFIG_64BIT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PRINTK=y
CONFIG_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLOCK=y
CONFIG_FILE_LOCKING=y
# Storage hot allocation needs upstream per-CPU SLUB paths, not tinyconfig's
# shared-node size-saving allocator. Keep unrelated debug/stacktrace off.
# CONFIG_SLUB_TINY is not set
# CONFIG_SLUB_DEBUG is not set
# Native stack-switch, IBT and ISA instructions have no hosted machine grant.
# CONFIG_VMAP_STACK is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_ISA_DMA_API is not set
CONFIG_EXT4_FS=m
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_JBD2=m
CONFIG_FS_MBCACHE=m
CONFIG_CRC16=m
# ext4 and jbd2 checksum every metadata and journal block with crc32c.
# tinyconfig's size-saving choice leaves only the byte-at-a-time table form,
# which profiling put at about a fifth of warm create/unlink/mkdir time.
CONFIG_CRC_OPTIMIZATIONS=y
# One VFS/storage runtime hosts all supported persistent root filesystems.
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
# CONFIG_XFS_ONLINE_SCRUB is not set
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
# Btrfs checksum algorithms are modules; their crypto registration/manager
# must be initialized by the shared core before module init can register them.
CONFIG_CRYPTO=y
