# SPDX-License-Identifier: GPL-2.0-only
# AX210 station driver and standard Linux supplicant socket infrastructure.
# Linux IPv4 supports the supplicant's ioctl socket; netd owns IP configuration.
CONFIG_KOBOX_HOSTED=y
CONFIG_64BIT=y
# CONFIG_VMAP_STACK is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_ISA_DMA_API is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NAMESPACES=y
# Only mount isolation is needed; the driver and supplicant share init_net.
# CONFIG_UTS_NS is not set
# CONFIG_TIME_NS is not set
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_NET_NS is not set
CONFIG_PRINTK=y
CONFIG_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IP_PNP is not set
# CONFIG_IPV6 is not set
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_CFG80211=m
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
# CONFIG_CFG80211_CERTIFICATION_ONUS is not set
# CONFIG_CFG80211_WEXT is not set
CONFIG_MAC80211=m
# CONFIG_MAC80211_HWSIM is not set
# CONFIG_MAC80211_MESH is not set
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# CONFIG_IWLDVM is not set
# CONFIG_IWLMLD is not set
# CONFIG_IWLMEI is not set
# CONFIG_IWLWIFI_LEDS is not set
# CONFIG_IWLWIFI_DEVICE_TRACING is not set
CONFIG_RFKILL=m
# CONFIG_RFKILL_INPUT is not set
CONFIG_FW_LOADER=m
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_COMPRESS is not set
# Keep algorithm lookup independent of runtime module auto-loading.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_RSA=y
CONFIG_KEYS=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
# Standard foreground Linux userspace event loop support.
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
# CONFIG_VIRTIO_NET is not set
# CONFIG_R8169 is not set
